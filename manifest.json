{
  "manifest_version": 3,
  "name": "Gilmedia SERP Counter",
  "version": "1.9.0",
  "description": "Numbers Google results by true rank across pages and highlights your whole domain list in organic, Ads, local pack and Maps.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.ca/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.com.au/search*",
        "*://www.google.ie/search*",
        "*://www.google.co.nz/search*",
        "*://www.google.fr/search*",
        "*://www.google.de/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.nl/search*",
        "*://www.google.com.mx/search*",
        "*://www.google.com.br/search*",
        "*://www.google.co.in/search*",
        "*://www.google.com/maps/*",
        "*://www.google.ca/maps/*",
        "*://www.google.co.uk/maps/*",
        "*://www.google.com.au/maps/*",
        "*://www.google.ie/maps/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/serp.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Gilmedia SERP Counter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
