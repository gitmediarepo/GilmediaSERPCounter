{
  "manifest_version": 3,
  "name": "Gilmedia SERP Counter",
  "version": "1.6.0",
  "description": "True rank numbering across Google result pages. Load your whole client list and see which of them appear in organic, Ads, the local pack, LSA and Maps.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.google.com/*",
    "*://www.google.ca/*",
    "*://www.google.co.uk/*",
    "*://www.google.com.au/*",
    "*://www.google.ie/*",
    "*://www.google.co.nz/*",
    "*://www.google.fr/*",
    "*://www.google.de/*",
    "*://www.google.es/*",
    "*://www.google.it/*",
    "*://www.google.nl/*",
    "*://www.google.com.mx/*",
    "*://www.google.com.br/*",
    "*://www.google.co.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.ca/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.com.au/search*",
        "*://www.google.ie/search*",
        "*://www.google.co.nz/search*",
        "*://www.google.fr/search*",
        "*://www.google.de/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.nl/search*",
        "*://www.google.com.mx/search*",
        "*://www.google.com.br/search*",
        "*://www.google.co.in/search*",
        "*://www.google.com/maps/*",
        "*://www.google.ca/maps/*",
        "*://www.google.co.uk/maps/*",
        "*://www.google.com.au/maps/*",
        "*://www.google.ie/maps/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/serp.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Gilmedia SERP Counter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
